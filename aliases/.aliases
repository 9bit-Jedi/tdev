# _gwt_dirname <branch> — turn a branch name into a safe worktree dir suffix:
# slashes -> dashes, anything else unsafe stripped, no leading/trailing dash.
_gwt_dirname() {
  printf '%s' "${1//\//-}" | tr -c 'A-Za-z0-9._-' '-' | sed 's/-\{2,\}/-/g; s/^-//; s/-$//'
}

# gwt [branch] — no arg: fzf switch to an existing worktree, or create one
# (existing/remote/new branch). With arg: old scripted add+cd for <branch>.
gwt() {
  # NOTE: never `local path` in zsh — it shadows the special $path array and
  # empties $PATH inside the function (git/awk become "command not found").
  local main_root sel branch wt
  main_root=$(git worktree list --porcelain | awk '/^worktree /{print $2; exit}') \
    || return 1

  if [ -n "$1" ]; then
    branch="$1"; wt="$(dirname "$main_root")/$(_gwt_dirname "$branch")"
    if git show-ref --verify --quiet "refs/heads/$branch"; then
      git worktree add "$wt" "$branch"
    else
      git worktree add "$wt" -b "$branch"
    fi
    cd "$wt"; return
  fi

  sel=$( { git worktree list | awk '{print $1}'; echo "＋ new worktree"; } \
         | fzf --prompt="worktree> " )
  [ -z "$sel" ] && return 0
  if [ "$sel" != "＋ new worktree" ]; then cd "$sel"; return; fi

  branch=$( { echo "«type new branch»";
              git branch -a --format='%(refname:short)' | grep -v HEAD \
                | sed 's#^origin/##' | sort -u; } | fzf --prompt="base branch> " )
  [ -z "$branch" ] && return 0
  if [ "$branch" = "«type new branch»" ]; then
    printf "new branch name: "; read branch; [ -z "$branch" ] && return 0
    wt="$(dirname "$main_root")/$(_gwt_dirname "$branch")"; git worktree add "$wt" -b "$branch"
  else
    wt="$(dirname "$main_root")/$(_gwt_dirname "$branch")"
    if git show-ref --verify --quiet "refs/heads/$branch"; then
      git worktree add "$wt" "$branch"
    else
      git worktree add "$wt" -b "$branch" --track "origin/$branch"
    fi
  fi
  cd "$wt"
}

# cgprov — provision the CURRENT codingal worktree for docker: copy env files
# from the primary worktree, share its .data DB. Run manually when needed.
#
# .data itself stays a REAL dir (not a symlink) — the repo's `.data/` gitignore
# rule (trailing slash) only matches directories, not a symlink named .data, so
# a top-level symlink shows up as untracked. Only the mysql/redis children are
# symlinked; docker-compose still finds .data/mysql and .data/redis unchanged.
cgprov() {
  local main_root d
  git rev-parse --show-toplevel >/dev/null 2>&1 || { echo "not a git repo"; return 1; }
  main_root=$(git worktree list --porcelain | awk '/^worktree /{print $2; exit}')
  [ "$main_root" = "$PWD" ] && { echo "already in primary worktree"; return 0; }
  for f in api/.env web/.env polr/.env; do
    [ -f "$main_root/$f" ] && [ ! -e "$PWD/$f" ] && cp "$main_root/$f" "$PWD/$f" \
      && echo "copied $f"
  done
  mkdir -p .data
  for d in mysql redis; do
    [ -d "$main_root/.data/$d" ] && [ ! -e ".data/$d" ] \
      && ln -s "$main_root/.data/$d" ".data/$d" && echo "linked .data/$d -> $main_root/.data/$d"
  done
  # node_modules: hardlink-copy from the primary worktree. Instant + near-zero
  # disk, but still a real independent dir, so `yarn install` here can diverge
  # without touching the primary's copy. Run yarn install after if deps changed.
  for d in web-sdk web storybook; do
    [ -d "$main_root/$d/node_modules" ] && [ ! -e "$PWD/$d/node_modules" ] \
      && mkdir -p "$PWD/$d" \
      && cp -al "$main_root/$d/node_modules" "$PWD/$d/node_modules" \
      && echo "cloned $d/node_modules"
  done
}

