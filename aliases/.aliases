# shell function :

# fkill — fuzzy-find and kill a process (replaces `ports`/manual grep+kill)
fkill() {
  local pid
  pid=$(ps -eo pid,ppid,user,%cpu,%mem,comm --sort=-%cpu | fzf --header-lines=1 | awk '{print $1}')
  [ -n "$pid" ] && kill -${1:-9} "$pid"
}

# fcd — fuzzy cd into any dir under a root, with preview
fcd() {
  local dir
  dir=$(fd --type d . "${1:-.}" 2>/dev/null | fzf --preview 'eza --tree --level=2 {}') && cd "$dir"
}

# mkcd — mkdir + cd in one step
mkcd() { mkdir -p "$1" && cd "$1"; }

# extract — universal archive extraction
extract() {
  case "$1" in
    *.tar.gz|*.tgz) tar xzf "$1" ;;
    *.tar.bz2) tar xjf "$1" ;;
    *.zip) unzip "$1" ;;
    *.tar) tar xf "$1" ;;
    *) echo "unknown archive type" ;;
  esac
}

# gcof — fuzzy git checkout across local + remote branches, with commit preview
gcof() {
  local branch
  branch=$(git branch -a --format='%(refname:short)' |
    grep -v HEAD | sed 's#^origin/##' | sort -u |
    fzf --preview 'git log --color=always --oneline -20 {}') && git checkout "$branch"
}

# gdiff — fuzzy-pick a changed file and view its diff, paginated with bat
gdiff() {
  local file
  file=$(git diff --name-only "$@" | fzf --preview "git diff --color=always $* -- {}") && \
    git diff --color=always "$@" -- "$file" | less -R
}

# fdocker — fuzzy exec into a running container
fdocker() {
  local cid
  cid=$(docker ps --format '{{.ID}} {{.Names}} {{.Image}}' | fzf | awk '{print $1}')
  [ -n "$cid" ] && docker exec -it "$cid" ${SHELL:-/bin/bash}
}

# fdlogs — fuzzy-follow logs of a running container
fdlogs() {
  local cid
  cid=$(docker ps --format '{{.ID}} {{.Names}} {{.Image}}' | fzf | awk '{print $1}')
  [ -n "$cid" ] && docker logs -f "$cid"
}
